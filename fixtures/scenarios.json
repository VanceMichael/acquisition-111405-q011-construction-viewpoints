      {"path": "/topic/1", "body": {"topicId": "t1", "revision": 1, "viewpoints": ["/view/1"], "documents": []}, "status": 200, "method": "GET"},
      {"path": "/view/1", "body": {"id": "v1", "model": {"project": "p", "revision": "r1"}, "visibility": {"default": true, "exceptions": []}, "selection": ["c1"], "coloring": [], "snapshot": null}, "status": 200, "method": "GET"},
      {"path": "/models/p/r1", "body": {"components": ["c1", "c2"]}, "status": 200, "method": "GET"}
    ],
    "expected": [
      {"topicId": "t1", "viewpointId": "v1", "selected": ["p/r1/c1"], "unresolvedComponents": []}
    ],
    "forbidden": [],
    "complete": true
  },
